# ============================================
# Agent Harness 环境配置
# ============================================

## 🚀 必需配置 —— LLM 统一走 OpenAI v1 兼容接口
# 适用：OpenAI 官方 / 智谱(open.bigmodel.cn/api/paas/v4) / DeepSeek / 通义 / 本地 vLLM 等
OPENAI_API_KEY=paste-your-key-here
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

## 📊 生成参数
TEMPERATURE=0.3
MAX_TOKENS=2048

## 🔄 ReAct 循环配置
MAX_ITERATIONS=6

## 🧠 记忆系统
SHORT_TERM_WINDOW=20
# 会话压缩：超过阈值条数时用 LLM 把较旧对话压成滚动摘要，
# LLM 视角 = 摘要 + 最近 KEEP_RECENT 条（上下文工程核心）
CONTEXT_COMPRESS_ENABLED=true
CONTEXT_COMPRESS_THRESHOLD=28
CONTEXT_KEEP_RECENT=16
CONTEXT_SUMMARY_MAX_CHARS=500
# 长期记忆：基于 ChromaDB 的跨会话语义记忆
LONG_TERM_ENABLED=true
LONG_TERM_TOP_K=3
LONG_TERM_STORE_PATH=./data/memory_store
# 检索距离超过该值的历史视为不相关，不注入 prompt（留空表示不过滤）
# LONG_TERM_MAX_DISTANCE=

## 💰 Token 预算（单会话）
# TOKEN_BUDGET_PER_SESSION=120000
# TOKEN_BUDGET_ALERT_RATIO=0.8
# TOKEN_BUDGET_HARD_STOP=false
# PROMPT_INJECTION_BLOCK=true          # Prompt 注入拦截开关
# RERANK_ENABLED=true                    # LLM as Reranker 开关

## 🛡 安全护栏
RATE_LIMIT_MAX_REQUESTS=60           # 每会话每窗口最大请求数（按 session_id 隔离）
RATE_LIMIT_WINDOW_SECONDS=60

## 📚 知识库配置（本地BGE模型）
KNOWLEDGE_STORE_PATH=./data/chroma_db
RETRIEVAL_TOP_K=5                     # 检索结果数量
RETRIEVAL_CANDIDATES=50               # 两阶段检索候选池大小
HYBRID_SEARCH_ALPHA=0.5               # 混合检索 BM25 关键字通道权重（RRF 融合）

## 🔧 工具配置
TOOL_MAX_RETRIES=1                  # 工具失败重试次数

## 📈 可观测性
LOG_LEVEL=INFO
LOG_FORMAT=console                   # json / console
TRACING_ENABLED=true
TRACER_MAX_RECORDS=500               # 调用链追踪记录上限（防内存泄漏）

## 🌐 Web服务
WEB_HOST=localhost
WEB_PORT=8000
CORS_ORIGINS=["*"]                   # JSON 数组格式，生产环境请改为具体来源

## 🗄️ 存储与安全
DB_PATH=./data/harness.db               # SQLite 业务库（订单/物流/商品/售后）
ADMIN_TOKEN=demo-admin-token           # 商品管理 API 鉴权（生产务必修改）

## 📦 数据目录
DATA_DIR=./data

## ⏰ 会话清理（小时）
SESSION_CLEANUP_HOURS=24
