# ============================================
# Agent Harness 环境配置（示例模板）
# 与 src/harness/config.py 的 Settings 默认值完全对齐
# 复制为 .env 后按需修改
# ============================================

## 🚀 必需配置 —— LLM 统一走 OpenAI v1 兼容接口
OPENAI_API_KEY=            # API 密钥（OpenAI/智谱/DeepSeek/讯飞等）
OPENAI_API_URL=            # OpenAI v1 兼容网关地址，如 https://api.openai.com/v1
OPENAI_MODEL=              # 主模型名，如 gpt-4o-mini

## 小模型（旁路低风险调用专用：事实抽取/重排）
# URL/KEY 留空继承主配置；MODEL 留空 = 未启用小模型，全部走主模型
OPENAI_SMALL_API_URL=      # 小模型网关（留空继承 OPENAI_API_URL）
OPENAI_SMALL_API_KEY=      # 小模型密钥（留空继承 OPENAI_API_KEY）
OPENAI_SMALL_MODEL=        # 小模型名（如 deepseek-chat）；留空=未启用

## 📊 生成参数
TEMPERATURE=0.3            # 采样温度，越低越稳定
MAX_TOKENS=2048            # 单次回复最大输出 token

## 🔄 ReAct 循环配置
MAX_ITERATIONS=20          # 单轮对话最大推理-工具调用迭代次数

## 🧠 记忆系统
CONTEXT_COMPRESS_ENABLED=true      # 会话压缩总开关
CONTEXT_WINDOW_TOKENS=262144       # 所用模型上下文窗口（token），决定压缩触发阈值
CONTEXT_COMPRESS_RATIO=0.75        # 触发压缩的窗口占用比例（达到窗口 75% 触发）
CONTEXT_KEEP_RECENT=20             # 压缩时保留的最近消息条数
CONTEXT_SUMMARY_MAX_CHARS=1500     # 压缩摘要最大字符数
LONG_TERM_ENABLED=true             # 跨会话语义记忆开关
LONG_TERM_STORE_PATH=./data/memory_store   # 长期记忆向量库存储目录
LONG_TERM_TOP_K=10                 # 每轮注入 prompt 的召回条数
LONG_TERM_MAX_DISTANCE=0.45        # 检索距离阈值，超过视为不相关（None=不过滤）
LONG_TERM_TTL_DAYS=30              # 低价值记录保留天数（含标识符的高价值记录豁免）
LONG_TERM_DUP_DISTANCE=0.20        # 近重复判定阈值，低于此值合并删除旧条
LONG_TERM_MAX_RECORDS=500          # 容量上限，超出按「低价值且最旧」淘汰

## 💰 Token 预算（单会话）
TOKEN_BUDGET_PER_SESSION=128000    # 单会话累计 token 预算（0=不限制）
TOKEN_BUDGET_ALERT_RATIO=0.8       # 使用率达到该比例时告警
TOKEN_BUDGET_HARD_STOP=false       # 超预算是否硬停（false=仅告警）

## 🛡 安全护栏
RATE_LIMIT_MAX_REQUESTS=20         # 每会话每窗口最大请求数
RATE_LIMIT_WINDOW_SECONDS=10       # 限流时间窗（秒）
PROMPT_INJECTION_BLOCK=true        # Prompt 注入拦截开关

## 📚 知识库配置（本地BGE模型）
KNOWLEDGE_STORE_PATH=./data/chroma_db      # 商品知识库向量库目录
RETRIEVAL_TOP_K=10                         # 注入 prompt 的检索结果数
RETRIEVAL_CANDIDATES=50                    # 两阶段检索候选池大小
RETRIEVAL_RELEVANCE_FLOOR=0.85             # 向量距离上限，超过自动放宽重查
RERANK_ENABLED=false                        # LLM as Reranker 开关
RERANK_TOP_N=20                            # 主模型重排候选数
RERANK_SMALL_TOP_N=8                       # 小模型重排候选数（缩小输入量）
HYBRID_SEARCH_ALPHA=0.7                    # BM25 关键词通道权重（0=纯向量，1=纯关键词）
HF_HUB_OFFLINE=true                        # 本地 BGE 模型优先，禁止 HF 联网检查（网络受限环境防超时）

## 🔧 工具与 LLM 重试
TOOL_MAX_RETRIES=3                        # 工具失败重试次数
LLM_MAX_RETRIES=5                         # LLM 瞬时错误重试次数
LLM_RETRY_BACKOFF_SEC=5                   # 重试基础退避秒数

## 📈 可观测性
LOG_LEVEL=INFO                  # 日志级别
LOG_FORMAT=json                 # 日志格式：json / console
LOG_DIR=./data/logs             # 日志文件目录（按天轮转，保留 LOG_BACKUP_DAYS 天）
LOG_BACKUP_DAYS=7               # 日志文件保留天数
TRACING_ENABLED=true            # 推理链路追踪开关
TRACER_MAX_RECORDS=1000         # 追踪记录上限（防内存泄漏）
AUDIT_ROTATE_MB=20              # 审计日志单文件轮转阈值（MB）
STREAM_INCLUDE_USAGE=true       # 流式响应返回真实 usage

## 🌐 Web服务
WEB_HOST=localhost              # 监听地址；部署到服务器改为 0.0.0.0
WEB_PORT=8000                   # 服务端口
CORS_ORIGINS=["*"]              # 跨域白名单（JSON 数组，生产改为具体来源）

## 🗄️ 存储与安全
DB_PATH=./data/harness.db       # SQLite 业务库路径
ADMIN_TOKEN=demo-admin-token    # 商品管理 API 鉴权 Token（生产务必修改）
DATA_DIR=./data                 # 数据根目录

## 🏷 发布渠道
RELEASE_CHANNEL=stable          # stable / canary（当前代码暂未消费）

## ⏰ 会话清理（小时）
SESSION_CLEANUP_HOURS=360       # 会话过期清理（小时），360=15 天
