# ============================================
# Agent Harness 环境配置（示例模板）
# 与 src/harness/config.py 的 Settings 默认值完全对齐
# 复制为 .env 后按需修改
# ============================================

## 🚀 必需配置 —— LLM 统一走 OpenAI v1 兼容接口
# 适用：OpenAI 官方 / 智谱(open.bigmodel.cn/api/paas/v4) / DeepSeek / 通义 / 本地 vLLM 等
OPENAI_API_KEY=paste-your-key-here
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

## 📊 生成参数
TEMPERATURE=0.3
MAX_TOKENS=2048

## 🔄 ReAct 循环配置
MAX_ITERATIONS=6

## 🧠 记忆系统
# KV-cache 友好：窗口内只追加不淘汰，达到阈值后由 LLM 压缩为滚动摘要
SHORT_TERM_WINDOW=100
CONTEXT_COMPRESS_ENABLED=true
CONTEXT_COMPRESS_THRESHOLD=100
CONTEXT_KEEP_RECENT=20
CONTEXT_SUMMARY_MAX_CHARS=2000
# 长期记忆：基于 ChromaDB 的跨会话语义记忆
LONG_TERM_ENABLED=false
LONG_TERM_STORE_PATH=./data/memory_store
LONG_TERM_TOP_K=3
# 检索距离超过该值的历史视为不相关，不注入 prompt；留空（None）表示不过滤
LONG_TERM_MAX_DISTANCE=0.45
# 维护策略（启动后首次使用时后台执行一次）
LONG_TERM_TTL_DAYS=90            # 低价值记录保留期；含订单号/金额等标识符的高价值记录豁免
LONG_TERM_DUP_DISTANCE=0.08      # 近重复判定：与更新记录距离低于此值 → 合并删除旧条
LONG_TERM_MAX_RECORDS=5000       # 容量熔断：超出后按「低价值且最旧」优先淘汰

## 💰 Token 预算（单会话）
TOKEN_BUDGET_PER_SESSION=120000
TOKEN_BUDGET_ALERT_RATIO=0.8
TOKEN_BUDGET_HARD_STOP=false

## 🛡 安全护栏
RATE_LIMIT_MAX_REQUESTS=60       # 每会话每窗口最大请求数（按 session_id 隔离）
RATE_LIMIT_WINDOW_SECONDS=60
PROMPT_INJECTION_BLOCK=true      # Prompt 注入拦截开关

## 📚 知识库配置（本地BGE模型）
KNOWLEDGE_STORE_PATH=./data/chroma_db
RETRIEVAL_TOP_K=5                # 检索结果数量
RETRIEVAL_CANDIDATES=50          # 两阶段检索候选池大小
RETRIEVAL_RELEVANCE_FLOOR=0.85   # 向量距离超过该值触发放宽重查
RERANK_ENABLED=true              # LLM as Reranker 开关
RERANK_TOP_N=20                  # 进入精排的候选数
HYBRID_SEARCH_ALPHA=0.5          # 混合检索 BM25 关键字通道权重（RRF 融合）

## 🔧 工具与 LLM 重试
TOOL_MAX_RETRIES=1               # 工具失败重试次数
LLM_MAX_RETRIES=2                # LLM 瞬时错误重试次数
LLM_RETRY_BACKOFF_SEC=1.0        # 重试基础退避秒数

## 📈 可观测性
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json / console
TRACING_ENABLED=true
TRACER_MAX_RECORDS=500           # 调用链追踪记录上限（防内存泄漏）
AUDIT_ROTATE_MB=16               # 审计日志单文件轮转阈值
STREAM_INCLUDE_USAGE=true        # 流式响应返回真实 usage（供应商不支持时可关）

## 🌐 Web服务
WEB_HOST=localhost
WEB_PORT=8000
CORS_ORIGINS=["*"]               # JSON 数组格式，生产环境请改为具体来源

## 🗄️ 存储与安全
DB_PATH=./data/harness.db        # SQLite 业务库（订单/物流/商品/售后）
ADMIN_TOKEN=demo-admin-token     # 商品管理 API 鉴权（生产务必修改）
DATA_DIR=./data

## 🏷 发布渠道
RELEASE_CHANNEL=stable           # stable / canary

## ⏰ 会话清理（小时）
SESSION_CLEANUP_HOURS=24
