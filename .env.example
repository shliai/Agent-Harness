# ============================================
# Agent Harness 环境配置（最优配置模板）
# 本文件是「根据代码实际行为权衡」后给出的最优配置，而非简单照搬 config.py 默认值。
# 大多数 config.py 默认值本身已是最优（117/121 评测在此基线上通过）；
# 下方对偏离默认值的项均标注了理由。复制为 .env 后按需修改。
# ⚠ 部署相关项（API 网关/模型/主机/CORS/Admin Token）必须按你的真实环境填写。
# ============================================

## 🚀 必需配置 —— LLM 统一走 OpenAI v1 兼容接口
# 最优：使用你实际可用的网关与模型（如 astron-code-latest）。弱模型下系统靠「确定性前置拦截」
# 而非模型自觉来保证路由，故模型选型以「稳定可用」为先，能力越强越好。
# ⚠ 代码内置默认为 kimi-k2-0905-preview（256k 窗口），与 CONTEXT_WINDOW_TOKENS=262144 对齐；
#   换任何模型都请同步改 CONTEXT_WINDOW_TOKENS 为其真实窗口。
OPENAI_API_KEY=            # API 密钥（OpenAI/智谱/DeepSeek/讯飞/Kimi/MaaS 等）
OPENAI_API_URL=            # OpenAI v1 兼容网关地址，如 https://api.moonshot.cn/v1
OPENAI_MODEL=              # 主模型名，如 astron-code-latest

## 小模型（旁路低风险调用专用：事实抽取/重排）
# 最优：若网关提供更快/更便宜的小模型，务必启用——事实抽取与重排每轮都跑，走小模型显著降成本/延迟。
# URL/KEY 留空继承主配置；MODEL 留空 = 未启用小模型，全部走主模型。
OPENAI_SMALL_API_URL=
OPENAI_SMALL_API_KEY=
OPENAI_SMALL_MODEL=

## 📊 生成参数
# 事实全部来自工具返回，temperature 只需保证回复自然度；0.3 在稳定性与通顺间最优。
TEMPERATURE=0.3            # 采样温度，越低越稳定
MAX_TOKENS=2048            # 单次回复最大输出 token（客服回答远不需要更长）

## 🔄 ReAct 循环配置
# 最优=6（非 20）：确定性前置拦截已覆盖绝大多数意图（首步强制检索 / 只读意图强制工具），
# 正常对话 2~3 步即结束；20 只会放大最坏情况延迟与 token 浪费，且评测已在 6 步下 16/16 路由、8/8 工具。
MAX_ITERATIONS=6           # 单轮对话最大推理-工具调用迭代次数（限制最坏情况耗时）

## 🧠 记忆系统
CONTEXT_COMPRESS_ENABLED=true      # 会话压缩总开关（KV-cache 友好，必开）
# ⚠ 必须 = 实际部署模型的上下文窗口（token）。压缩在「窗口×比例」处触发；
# 若填得比真实窗口大，会在超出模型能力后才压缩导致超窗。未知时按模型真实长度填（如 128000）。
CONTEXT_WINDOW_TOKENS=262144       # 所用模型上下文窗口（token），决定压缩触发阈值
CONTEXT_COMPRESS_RATIO=0.75        # 触发压缩的窗口占用比例（达到窗口 75% 触发，留余量防启发式低估）
CONTEXT_KEEP_RECENT=20             # 压缩时保留的最近消息条数（多轮指代不掉上下文）
CONTEXT_SUMMARY_MAX_CHARS=2000     # 压缩摘要最大字符数（足够承载一周期事实 + 任务状态快照）
# 学习机制（长期用户画像）：确定性捕获偏好/约束/纠正，JSON 存储，注入系统提示词。
# 单用户、无向量、无 LLM 自由抽取——轮末直接读取工作记忆，数据量小、污染风险低。
# 最优=开启（非默认 false）：跨会话个性化对客服场景价值高，仅作提示不改写检索结果。
LEARNING_ENABLED=true              # 学习机制开关（推荐生产开启）
LEARNING_STORE_PATH=./data/learning_store   # 学习记忆 JSON 存储目录
LEARNING_TTL_DAYS=365             # 学习记录保留期（天）；约束/偏好长期有效
LEARNING_MAX_ITEMS=50             # 单用户画像容量上限（超则按优先级+最旧淘汰）
LEARNING_CONFIDENCE_THRESHOLD=0.0 # 置信度阈值（确定性捕获恒为 1.0，此处仅占位）

## 💰 Token 预算（单会话）
TOKEN_BUDGET_PER_SESSION=120000    # 单会话累计 token 预算（应 < 模型窗口；0=不限制）
TOKEN_BUDGET_ALERT_RATIO=0.8       # 使用率达到该比例时告警
TOKEN_BUDGET_HARD_STOP=false       # 超预算是否硬停（false=仅告警，避免中断用户会话）

## 🛡 安全护栏
RATE_LIMIT_MAX_REQUESTS=60         # 每会话每窗口最大请求数（1/s，正常用户不会触顶，仍能拦滥用）
RATE_LIMIT_WINDOW_SECONDS=60       # 限流时间窗（秒）
PROMPT_INJECTION_BLOCK=true        # Prompt 注入拦截开关（安全必开）

## 📚 知识库配置（本地BGE模型）
KNOWLEDGE_STORE_PATH=./data/chroma_db      # 商品知识库向量库目录
# 最优=5（非 10）：注入 5 条已足够推荐/比价，过多会稀释注意力、增加 token、引入噪声。
RETRIEVAL_TOP_K=5                          # 注入 prompt 的检索结果数
RETRIEVAL_CANDIDATES=50                    # 两阶段检索候选池大小（召回够宽，重排再精筛）
RETRIEVAL_RELEVANCE_FLOOR=0.85             # 向量距离上限，超过自动放宽重查（兜底防空结果）
RERANK_ENABLED=true                        # LLM as Reranker 开关（必开：显著提升精排精度；解析失败/超时回退 RRF，不阻塞）
RERANK_TOP_N=20                            # 主模型重排候选数
RERANK_SMALL_TOP_N=8                       # 小模型重排候选数（缩小输入量）
# 最优=0.5（向量/BM25 等权融合）：商品检索既需语义（向量）也需型号/规格精确命中（BM25），均衡最稳。
HYBRID_SEARCH_ALPHA=0.5                    # BM25 关键词通道权重（RRF 融合；0=纯向量，1=纯关键词）
HF_HUB_OFFLINE=true                        # 本地 BGE 模型优先，禁止 HF 联网检查（网络受限环境防超时）

## 🔧 工具与 LLM 重试
# 最优=2（非默认 1）：工具调用偶发 DB/网络抖动，1 次重试即可兜底，又不至拖慢。
TOOL_MAX_RETRIES=2                        # 工具失败重试次数
# 最优=2（非 5）：瞬时错误重试 2 次足够；5 次会在持续故障时长时间挂起、放大延迟。
LLM_MAX_RETRIES=2                         # LLM 瞬时错误重试次数
LLM_RETRY_BACKOFF_SEC=1.0                 # 重试基础退避秒数（指数退避，1s 起合理）

## 📈 可观测性
LOG_LEVEL=INFO                  # 日志级别（生产可降为 WARNING 减噪，但 INFO 利于排障）
LOG_FORMAT=json                 # 日志格式：json / console（json 便于采集聚合）
LOG_DIR=./data/logs             # 日志文件目录（按天轮转，保留 LOG_BACKUP_DAYS 天）
LOG_BACKUP_DAYS=7               # 日志文件保留天数（生产审计建议 30）
TRACING_ENABLED=true            # 推理链路追踪开关（排障可见性，必开）
TRACER_MAX_RECORDS=500          # 追踪记录上限（防内存泄漏）
AUDIT_ROTATE_MB=16              # 审计日志单文件轮转阈值（MB）
STREAM_INCLUDE_USAGE=true       # 流式响应返回真实 usage（token 核算准确）

## 🌐 Web服务
WEB_HOST=localhost              # 监听地址；部署到服务器改为 0.0.0.0
WEB_PORT=8000                   # 服务端口
# 跨域白名单（JSON 数组）：留空/不配置 = 仅同源访问（默认，最安全）；
# 前后端分离时改为具体前端来源，绝不推荐 *
CORS_ORIGINS=[]

## 🗄️ 存储与安全
DB_PATH=./data/harness.db       # SQLite 业务库路径
ADMIN_TOKEN=demo-admin-token    # 商品管理 API 鉴权 Token（⚠ 生产必须改为强随机密钥；
                                #   留空 = 管理端 API 全部禁用 fail-closed）
DATA_DIR=./data                 # 数据根目录

## 🏷 发布渠道
RELEASE_CHANNEL=stable          # stable / canary（当前代码暂未消费）

## ⏰ 会话清理（小时）
SESSION_CLEANUP_HOURS=24        # 会话过期清理（小时），24=1 天（客服场景无需长留）
