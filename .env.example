# ============================================
# Agent Harness 环境配置
# ============================================

## 🚀 必需配置
# LLM 服务提供商 (zhipu / openai)
LLM_PROVIDER=zhipu

## 🔑 智谱AI配置（推荐）
ZHIPU_API_KEY=paste-your-key-here
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

## 🔑 OpenAI配置（可选）
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

## 📊 生成参数
TEMPERATURE=0.3
MAX_TOKENS=2048

## 🔄 ReAct 循环配置
MAX_ITERATIONS=6

## 🧠 记忆系统
SHORT_TERM_WINDOW=20
# 长期记忆（v0.2.0 新增）：基于 ChromaDB 的跨会话语义记忆
LONG_TERM_ENABLED=false              # true 启用，关闭时零开销
LONG_TERM_TOP_K=3                    # 每轮召回相关历史对话条数
LONG_TERM_STORE_PATH=./data/memory_store

## 🛡️ 安全护栏
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

## 📚 知识库配置（本地BGE模型）
KNOWLEDGE_STORE_PATH=./data/chroma_db
RETRIEVAL_TOP_K=5                    # 检索结果数量
HYBRID_SEARCH_ALPHA=0.5             # 混合搜索权重（向量BM25平衡）

## 🔧 工具配置
TOOL_MAX_RETRIES=1                  # 工具失败重试次数

## 📈 可观测性
LOG_LEVEL=INFO
LOG_FORMAT=console                   # json / console
TRACING_ENABLED=true

## 🌐 Web服务
WEB_HOST=localhost
WEB_PORT=8000

## 📦 数据目录
DATA_DIR=./data

## ⏰ 会话清理（小时）
SESSION_CLEANUP_HOURS=24
